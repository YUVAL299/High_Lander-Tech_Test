# Copy to .env and adjust. Every setting is optional; defaults are shown.

# Port the game is served on (http://localhost:8080)
# HL_PORT=8080

# ---- Routing -----------------------------------------------------------------
# Walking routes from the free FOSSGIS OSRM server (no API key needed).
# docker-compose.osrm.yml switches this to a local OSRM container.
# HL_OSRM_URL=https://routing.openstreetmap.de/routed-foot
# HL_OSRM_TIMEOUT_S=5
# HL_OSRM_RETRIES=1

# Region used by the local OSRM (docker-compose.osrm.yml); see https://download.geofabrik.de
# OSRM_PBF_URL=https://download.geofabrik.de/asia/israel-and-palestine-latest.osm.pbf

# ---- Gameplay ----------------------------------------------------------------
# Goal is placed at a random walkable spot this far from the player (metres)
# HL_GOAL_MIN_DISTANCE_M=200
# HL_GOAL_MAX_DISTANCE_M=800
# How close counts as "reached" (metres)
# HL_GOAL_REACH_RADIUS_M=20

# Reroute when the player is this far off the route (metres)...
# HL_REROUTE_OFF_ROUTE_M=25
# ...but at most once every N seconds
# HL_REROUTE_MIN_INTERVAL_S=3

# ---- Operations --------------------------------------------------------------
# HL_LOG_LEVEL=INFO
# Idle sessions are removed after this many seconds
# HL_SESSION_TTL_S=3600
